LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
# The active log file rotates at LOG_MAX_FILE_MB or at midnight, whichever
# comes first, and the oldest archives are deleted to keep all logs under
# LOG_MAX_TOTAL_MB (0 disables a limit). DEBUG can write gigabytes a day,
# mostly SMB/SSH packet dumps; LOG_QUIET_THIRD_PARTY=true keeps PerchTail's
# own DEBUG detail while capping those libraries at INFO.
LOG_MAX_FILE_MB=100
LOG_MAX_TOTAL_MB=2048
LOG_QUIET_THIRD_PARTY=false

# Where state lives. The Docker image sets DATA_DIR=/data/db (database,
# credential salt, SSH known_hosts: back this one up), LOG_DIR=/data/logs and
# SCRATCH_DIR=/data/scratch, all inside the volume docker-compose.yml mounts;
# point any of them at its own volume to keep logs or scratch off the
# database's disk. Only uncomment these when running `uvicorn` directly on
# the host without Docker:
# DATA_DIR=./data/db
# LOG_DIR=./data/logs
# SCRATCH_DIR=./data/scratch
# DATABASE_URL, CREDENTIAL_SALT_PATH and SSH_KNOWN_HOSTS_PATH default to
# files inside DATA_DIR; set them only to put one of them elsewhere.

# Encrypts SSH/SMB/WinRM credentials at rest. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CREDENTIAL_ENCRYPTION_KEY=changeme

# The key above is stretched with a per-install random salt stored at
# CREDENTIAL_SALT_PATH (by default DATA_DIR/credential_salt). Back it
# up together with the database and keep it on the persistent volume: without
# it, nothing encrypted can be decrypted, even with the right key.

# Encrypted online backups (docs/backup-and-restore.md): `python -m app.backup
# create` and the scheduled backup (Settings -> System) write them to
# BACKUP_DIR (by default `backups` next to DATA_DIR; /data/backups in the
# Docker image), keeping the last BACKUP_KEEP manual and scheduled ones and
# the last 3 pre-upgrade ones.
# BACKUP_DIR=./data/backups
BACKUP_KEEP=7
# Backups are always encrypted. By default their key is derived from
# CREDENTIAL_ENCRYPTION_KEY, so restoring needs that key (after a key
# rotation, older backups need the old one). Set BACKUP_ENCRYPTION_KEY to give
# backups a key of their own, held by someone else or kept somewhere else
# than CREDENTIAL_ENCRYPTION_KEY (a password manager or vault), and never
# next to the backups: whoever holds a backup and its key can read the
# database in it (stored credentials stay encrypted under
# CREDENTIAL_ENCRYPTION_KEY). A backup made with it only decrypts with it.
# Generate one like CREDENTIAL_ENCRYPTION_KEY.
# BACKUP_ENCRYPTION_KEY=

# Username for the auto-seeded break-glass super-admin, created on first
# startup only (a deployment with zero users). Its password is randomly
# generated and printed once to the container logs — never set it here.
INITIAL_ADMIN_USERNAME=admin

# The externally-reachable URL this deployment is served at (no trailing
# slash) — used to build the OIDC redirect_uri registered with your IdP
# (SSO settings admin page). Only matters if SSO is configured; must match
# whatever's registered as the client's redirect URI there.
PUBLIC_BASE_URL=http://localhost:8080

SESSION_TTL_HOURS=12
# Set to false only for local HTTP development — browsers silently drop
# Secure cookies over plain HTTP.
SESSION_COOKIE_SECURE=true

# Login brute-force lockout: consecutive failed attempts against one
# username before it's locked out, and how long the lockout lasts.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# Local-disk sources: comma-separated absolute directories that admin-created
# "Local disk" sources may point at (e.g. a host log directory mounted
# read-only into the container). Empty (the default) disables them entirely --
# only the built-in application-log source reads local disk then. Set by the
# operator here, never from the web UI, so a web admin can't point a source at
# this server's own database or secrets.
# LOCAL_SOURCE_ROOTS=/mnt/host-logs

# Ephemeral fetch cache for remote sources (SSH/SMB/WinRM) — never a
# persistent copy, see CLAUDE.md's "Live browsing & ephemeral fetch behavior".
SCRATCH_MAX_GB=5.0
SCRATCH_IDLE_SECONDS=300
SCRATCH_SWEEP_INTERVAL_SECONDS=60
# Free space to keep on the filesystem holding SCRATCH_DIR: a new fetch is
# refused (HTTP 507) once free space would drop below the larger of the two,
# so a full scratch can't stop the database and the logs on the same disk.
# 0 for both turns the check off.
SCRATCH_MIN_FREE_GB=1
SCRATCH_MIN_FREE_PERCENT=5
# Largest size one .gz file or one .zip/.tar.gz member may decompress to
# before opening it is refused (HTTP 413) -- a guard against zip/gzip bombs.
MAX_DECOMPRESSED_MB=2048
# Largest single file a remote source will fetch, and the largest total a
# folder ZIP may collect, before the request is refused (HTTP 413).
MAX_FETCH_MB=2048
# Longest a connected SSH/SFTP or SMB source may stay silent before the call
# fails, so a server that stalls after login can't hold a worker forever.
REMOTE_READ_TIMEOUT_SECONDS=60
# How long a stop waits for running background jobs to finish. Keep the
# container's stop grace period above it (docker-compose.yml sets 30s).
SHUTDOWN_TIMEOUT_SECONDS=20

# Who may call the monitoring endpoints (docs/monitoring.md, "Who may call
# them"). Comma-separated addresses or CIDR blocks. /healthz and /readyz
# answer loopback (the Docker HEALTHCHECK), the monitoring token, and these
# networks: set it for a load balancer or kubelet that can't send a header.
# PROBE_ALLOWED_NETWORKS=10.0.0.0/8
# /monitoring/health and /metrics always need the monitoring token; when
# this is set, the caller must also be in one of these networks.
# MONITORING_ALLOWED_NETWORKS=192.0.2.10/32

# Release check: once a day, ask GitHub (api.github.com) which release is the
# latest, and show it to super admins under Settings -> System. Nothing about
# this install is sent. false = never make that request (air-gapped installs).
UPDATE_CHECK=true

# Push-agent upgrades from the portal: the folder holding the signed agent
# binaries of this version (the release's perchtail-agent-*, SHA256SUMS and
# SHA256SUMS.sig), served to connected agents. The Docker image sets
# /app/agent-binaries; leave it unset for an install from source, and agents
# download the release from GitHub instead.
# AGENT_BINARIES_DIR=/opt/perchtail/agent-binaries

# SSH host keys: "tofu" pins a new server's key on first connect and logs its
# fingerprint; "strict" refuses servers not already in SSH_KNOWN_HOSTS_PATH.
# See docs/source-setup.md's "Host-key pinning".
SSH_HOST_KEY_POLICY=tofu
