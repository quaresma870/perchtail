{
  "name": "tiny",
  "description": "Validates the kit on a development machine in about 25 minutes (12 without the growing-file phases). Not a sizing profile.",
  "customers": 1,
  "folders_per_customer": 2,
  "users": 4,
  "sources": {
    "ssh": 2,
    "smb": 1,
    "local": 1,
    "winrm": 0
  },
  "agents": {
    "running": 2,
    "stopped": 1
  },
  "files": {
    "app_folders": 2,
    "sizes_kb": [10, 200, 2048],
    "agent_sizes_kb": [10, 500],
    "per_size": 2,
    "gz": 2,
    "zip": 1,
    "large_mb": 48,
    "large_count": 2,
    "growing": 2,
    "growing_bytes_per_second": 2048,
    "growing_rotate_mb": 8,
    "growing_count": 2,
    "growing_size_mb": 5,
    "growing_rate_kb_s": 256,
    "growing_rotate_s": 60,
    "growing_agents": 1,
    "heavy_count": 2,
    "heavy_start_mb": 1,
    "heavy_rates_mb_s": [1],
    "heavy_step_seconds": 60,
    "heavy_rotate_mb": 64,
    "daily_size_gb": 0.1953125,
    "daily_duration_min": 5
  },
  "settings": {
    "tail_interval_seconds": 2,
    "explorer_refresh_seconds": 30,
    "source_check_minutes": 1,
    "name_index_enabled": true,
    "name_index_minutes": 5
  },
  "scenarios": {
    "browse": {
      "vus": 2,
      "think_seconds": [2, 6],
      "files_per_visit": [1, 3],
      "read_seconds": [5, 15],
      "thresholds": {"p95_ms": 1000, "error_rate": 0.01}
    },
    "follow": {
      "vus": 1,
      "follow_seconds": 45,
      "thresholds": {"p95_ms": 1000, "error_rate": 0.01}
    },
    "download": {
      "vus": 1,
      "think_seconds": [5, 15],
      "zip_every": 3,
      "thresholds": {"p95_ms": 5000, "error_rate": 0.01}
    },
    "name_search": {
      "vus": 1,
      "think_seconds": [3, 8],
      "thresholds": {"p95_ms": 500, "error_rate": 0.01}
    },
    "agents": {
      "vus": 1,
      "think_seconds": [2, 6],
      "files_per_visit": [1, 2],
      "read_seconds": [5, 10],
      "follow_seconds": 30,
      "thresholds": {"p95_ms": 1500, "error_rate": 0.01}
    },
    "background": {
      "thresholds": {"p95_ms": 1000, "error_rate": 0.01}
    },
    "large_files": {
      "vus": 2,
      "hold_seconds": [10, 20],
      "thresholds": {"p95_ms": 30000, "error_rate": 0.01}
    },
    "ramp": {
      "start_vus": 2,
      "step_vus": 2,
      "steps": 4,
      "step_seconds": 40,
      "think_seconds": [1, 3],
      "files_per_visit": [1, 2],
      "read_seconds": [2, 5],
      "warmup_seconds": 15,
      "min_requests": 20,
      "thresholds": {"p95_ms": 1000, "error_rate": 0.01}
    },
    "growing_files": {
      "vus": 2,
      "follow_vus": 2,
      "think_seconds": [2, 5],
      "follow_seconds": 100,
      "download_every": 3,
      "zip_every": 4,
      "thresholds": {"open_p95_ms": 15000, "download_p95_ms": 15000, "zip_p95_ms": 60000, "follow_p95_ms": 2000, "error_rate": 0.01}
    },
    "growing_heavy": {
      "followers_per_file": 1,
      "thresholds": {"open_p95_ms": 15000, "follow_p95_ms": 5000, "error_rate": 0.01}
    },
    "daily_log": {
      "vus": 1,
      "follow_vus": 1,
      "every_seconds": [20, 40],
      "thresholds": {"open_p95_ms": 60000, "download_p95_ms": 60000, "follow_p95_ms": 5000, "error_rate": 0.01}
    }
  },
  "phases": [
    {"name": "background", "duration": "60s", "scenarios": ["background"]},
    {"name": "mixed", "duration": "120s", "scenarios": ["browse", "follow", "download", "name_search", "agents"]},
    {"name": "mixed-index-off", "duration": "60s", "settings": {"name_index_enabled": false}, "scenarios": ["browse", "follow", "download", "agents"]},
    {"name": "large_files", "duration": "60s", "scenarios": ["large_files"]},
    {"name": "ramp", "scenarios": ["ramp"]},
    {"name": "growing_files", "duration": "150s", "scenarios": ["growing_files"]},
    {"name": "growing_heavy", "duration": "60s", "scenarios": ["growing_heavy"]},
    {"name": "daily_log", "duration": "5m", "scenarios": ["daily_log"]}
  ]
}
