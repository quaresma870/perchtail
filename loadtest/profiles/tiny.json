{
  "name": "tiny",
  "description": "Validates the kit on a development machine in under 15 minutes. Not a sizing profile.",
  "customers": 1,
  "folders_per_customer": 2,
  "users": 4,
  "sources": {
    "ssh": 2,
    "smb": 1,
    "local": 1,
    "winrm": 0
  },
  "agents": {
    "running": 2,
    "stopped": 1
  },
  "files": {
    "app_folders": 2,
    "sizes_kb": [10, 200, 2048],
    "agent_sizes_kb": [10, 500],
    "per_size": 2,
    "gz": 2,
    "zip": 1,
    "large_mb": 48,
    "large_count": 2,
    "growing": 2,
    "growing_bytes_per_second": 2048,
    "growing_rotate_mb": 8
  },
  "settings": {
    "tail_interval_seconds": 2,
    "explorer_refresh_seconds": 30,
    "source_check_minutes": 1,
    "name_index_enabled": true,
    "name_index_minutes": 5
  },
  "scenarios": {
    "browse": {
      "vus": 2,
      "think_seconds": [2, 6],
      "files_per_visit": [1, 3],
      "read_seconds": [5, 15],
      "thresholds": {"p95_ms": 1000, "error_rate": 0.01}
    },
    "follow": {
      "vus": 1,
      "follow_seconds": 45,
      "thresholds": {"p95_ms": 1000, "error_rate": 0.01}
    },
    "download": {
      "vus": 1,
      "think_seconds": [5, 15],
      "zip_every": 3,
      "thresholds": {"p95_ms": 5000, "error_rate": 0.01}
    },
    "name_search": {
      "vus": 1,
      "think_seconds": [3, 8],
      "thresholds": {"p95_ms": 500, "error_rate": 0.01}
    },
    "agents": {
      "vus": 1,
      "think_seconds": [2, 6],
      "files_per_visit": [1, 2],
      "read_seconds": [5, 10],
      "follow_seconds": 30,
      "thresholds": {"p95_ms": 1500, "error_rate": 0.01}
    },
    "background": {
      "thresholds": {"p95_ms": 1000, "error_rate": 0.01}
    },
    "large_files": {
      "vus": 2,
      "hold_seconds": [10, 20],
      "thresholds": {"p95_ms": 30000, "error_rate": 0.01}
    },
    "ramp": {
      "start_vus": 2,
      "step_vus": 2,
      "steps": 4,
      "step_seconds": 40,
      "think_seconds": [1, 3],
      "files_per_visit": [1, 2],
      "read_seconds": [2, 5],
      "warmup_seconds": 15,
      "min_requests": 20,
      "thresholds": {"p95_ms": 1000, "error_rate": 0.01}
    }
  },
  "phases": [
    {"name": "background", "duration": "60s", "scenarios": ["background"]},
    {"name": "mixed", "duration": "120s", "scenarios": ["browse", "follow", "download", "name_search", "agents"]},
    {"name": "mixed-index-off", "duration": "60s", "settings": {"name_index_enabled": false}, "scenarios": ["browse", "follow", "download", "agents"]},
    {"name": "large_files", "duration": "60s", "scenarios": ["large_files"]},
    {"name": "ramp", "scenarios": ["ramp"]}
  ]
}
