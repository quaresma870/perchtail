{
  "name": "production-mini",
  "description": "The production profile scaled down to validate it on a development machine: 10 sources, 5 users, 10 minutes. Not a sizing profile.",
  "customers": 2,
  "customer_names": ["brightwater-retail", "kestrel-freight", "harbourline-bank", "orchard-health", "nordvale-energy"],
  "folders_per_customer": 2,
  "folder_names": ["production", "staging", "shared-services"],
  "users": 5,
  "sources": {"ssh": 4, "smb": 2, "local": 1, "winrm": 0},
  "agents": {"running": 3, "stopped": 0, "windows": 1},
  "files": {
    "app_folders": 1,
    "sizes_kb": [10],
    "agent_sizes_kb": [10],
    "per_size": 1,
    "gz": 0,
    "zip": 0,
    "large_mb": 1,
    "large_count": 0,
    "growing": 0
  },
  "settings": {
    "tail_interval_seconds": 2,
    "explorer_refresh_seconds": 30,
    "source_check_minutes": 1,
    "name_index_enabled": true,
    "name_index_minutes": 5,
    "alerts_interval_seconds": 60,
    "backup_interval_hours": 1
  },
  "production": {
    "peak_users": 5,
    "start_users": 1,
    "end_users": 2,
    "ramp_up_minutes": 2,
    "peak_minutes": 5,
    "ramp_down_minutes": 2,
    "incident": {"minutes": 2, "users": 4, "zip_users": 1},
    "alerts": 3,
    "rate_classes": {"calm": {"share": 0.7, "kb_s": [2, 8], "rotate_mb": 64}, "moving": {"share": 0.25, "kb_s": [100, 300], "rotate_mb": 64}, "intense": {"share": 0.05, "daily_size_gb": 0.2}},
    "tree": {"app_folders": 3, "rotated": 3, "rotated_kb": [64, 256, 1024], "large_every": 5, "large_mb": 20},
    "personas": {"support": {"session_minutes": [2, 4], "read_seconds": [5, 20], "think_seconds": [3, 10]}, "oncall": {"session_minutes": [3, 6]}, "investigation": {"session_minutes": [2, 4], "think_seconds": [5, 15]}, "admin": {"session_minutes": [1, 3], "think_seconds": [5, 15]}, "occasional": {"session_minutes": [0.5, 1]}}
  },
  "scenarios": {
    "production": {"thresholds": {"error_rate": 0.01, "ops": {}}}
  },
  "phases": [
    {"name": "production", "duration": "10m", "scenarios": ["production"]}
  ]
}
