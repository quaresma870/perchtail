{
  "name": "protocol_matrix-mini",
  "description": "The protocol matrix scaled down to validate it on a development machine: one file size (1 MB), one small folder (100 entries), no added delay, 1 and 5 at once, about 15 minutes. Not a sizing profile.",
  "customers": 1,
  "folders_per_customer": 1,
  "users": 5,
  "sources": {"ssh": 2, "smb": 1, "local": 1, "winrm": 0},
  "hosts": {"ssh": ["lt-ssh", "lt-ssh-fault"]},
  "agents": {"running": 3, "stopped": 0, "windows": 1},
  "files": {
    "app_folders": 1,
    "sizes_kb": [10],
    "agent_sizes_kb": [10],
    "per_size": 1,
    "gz": 0,
    "zip": 0,
    "large_mb": 1,
    "large_count": 0,
    "growing": 0
  },
  "settings": {
    "tail_interval_seconds": 2,
    "explorer_refresh_seconds": 30,
    "source_check_minutes": 0,
    "name_index_enabled": true,
    "name_index_minutes": 1440
  },
  "matrix": {
    "lists": [100],
    "sizes_mb": [1],
    "parallelism": [1, 5],
    "delays_ms": [0],
    "follow_seconds": 20,
    "follow_rate_kb_s": 256,
    "repeat": {"list": 3, "open": 2, "download": 2},
    "login_storm": 10,
    "mfa_logins": 2,
    "capacity": [1, 2, 4, 8],
    "steps": ["matrix", "fixed", "features", "operation", "storms", "reliability"]
  },
  "scenarios": {
  },
  "phases": [
    {"name": "matrix", "duration": "1m", "scenarios": ["protocol_matrix"]}
  ]
}
